# Copy to backend/.env and adjust. Every value is optional: the defaults run FieldTrack locally.
# Never commit a real .env (it is git-ignored).

# Signing keys. Use long random strings outside local development, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# JWT_SECRET_KEY=defaults-to-SECRET_KEY

# Database (default: SQLite file at backend/instance/fieldtrack.db)
# DATABASE_URL=sqlite:///fieldtrack.db

# How long a staff login lasts, in hours (default 8)
# JWT_EXPIRES_HOURS=8

# Browser origins allowed to call the API, comma-separated (default: the Vite dev server)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where `python app.py` listens (default 127.0.0.1:5000)
# HOST=127.0.0.1
# PORT=5000

# Set to 1 for auto-reload and interactive tracebacks while developing (default off)
# FLASK_DEBUG=0

# Safety / emergency escalation: "real" (10 min idle, 2 min windows) or "demo" (15 s idle, 5 s windows)
# SAFETY_MODE=real
# SAFETY_SEED=1
# Any single setting can be overridden, e.g. SAFETY_IDLE_THRESHOLD_SECONDS=30
