# Copy to backend/.env and adjust. Every value is optional: the defaults run FieldTrack locally.
# Never commit a real .env (it is git-ignored).

# Mode: development (default; a built-in dev key is used if SECRET_KEY is unset), test or
# production. In production the app REFUSES TO START unless SECRET_KEY is a real random value of
# at least 32 characters (placeholders such as "change-me" are rejected too).
# APP_ENV=development

# Signing key. Required in production; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
# JWT_SECRET_KEY=defaults-to-SECRET_KEY

# Database (default: SQLite file at backend/instance/fieldtrack.db)
# DATABASE_URL=sqlite:///fieldtrack.db

# How long a staff login lasts, in hours (default 8)
# JWT_EXPIRES_HOURS=8

# Browser origins allowed to call the API, comma-separated (default: the Vite dev server)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where `python app.py` listens (default 127.0.0.1:5000)
# HOST=127.0.0.1
# PORT=5000

# Login throttling: failed attempts allowed per window before HTTP 429 (defaults shown)
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# LOGIN_MAX_FAILURES_PER_CLIENT=20
# LOGIN_RATE_WINDOW_SECONDS=300
# LOGIN_RATE_LIMIT_ENABLED=1

# Behind a reverse proxy: how many proxies to trust for the client address (default 0 = none)
# TRUSTED_PROXY_COUNT=0
# Send Strict-Transport-Security. Turn on ONLY when served over HTTPS.
# HSTS_ENABLED=0

# Set to 1 for auto-reload and interactive tracebacks while developing (default off)
# FLASK_DEBUG=0

# Safety / emergency escalation: "real" (10 min idle, 2 min windows) or "demo" (15 s idle, 5 s windows)
# SAFETY_MODE=real
# SAFETY_SEED=1
# Any single setting can be overridden, e.g. SAFETY_IDLE_THRESHOLD_SECONDS=30
